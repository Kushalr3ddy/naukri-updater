[Unit]
Description=Daily Naukri profile refresh

[Timer]
# Morning and night.
OnCalendar=*-*-* 09:30:00
OnCalendar=*-*-* 21:30:00
# Spread the run out so it never fires at the same second two days running.
RandomizedDelaySec=30m
# Catch up if the machine was asleep at the scheduled time.
Persistent=true

[Install]
WantedBy=timers.target
